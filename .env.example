# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# development | testing | production
APP_ENV=development

# REQUIRED in production (>= 32 random chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ofsd
TEST_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ofsd_test

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Email (SMTP). Sending is suppressed unless MAIL_SUPPRESS_SEND=false ---
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
MAIL_BCC=
EMAIL_QUEUE_INTERVAL_MINUTES=5
EMAIL_QUEUE_BATCH_SIZE=100

# --- Optional nightly pg_dump -> OneDrive backup ---
DB_BACKUP_ENABLED=false
PG_DUMP_PATH=pg_dump
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ONEDRIVE_USER_ID=
ONEDRIVE_BACKUP_FOLDER=OFSD-DB-Backups

MIN_DEPOSIT_USD=2000
